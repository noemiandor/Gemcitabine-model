#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(ggplot2)
})

cmd_args <- commandArgs(FALSE)
file_arg <- grep("^--file=", cmd_args, value = TRUE)
script_path <- if (length(file_arg) > 0) {
  normalizePath(sub("^--file=", "", file_arg[[1]]))
} else {
  normalizePath("ploidy_vs_TGI")
}
repo_root <- normalizePath(file.path(dirname(script_path), "..", ".."))

parse_args <- function(args) {
  out <- list(input = NULL, output_dir = NULL)
  i <- 1
  while (i <= length(args)) {
    arg <- args[[i]]
    if (startsWith(arg, "--input=")) {
      out$input <- sub("^--input=", "", arg)
    } else if (arg == "--input") {
      i <- i + 1
      out$input <- args[[i]]
    } else if (startsWith(arg, "--output-dir=")) {
      out$output_dir <- sub("^--output-dir=", "", arg)
    } else if (arg == "--output-dir") {
      i <- i + 1
      out$output_dir <- args[[i]]
    } else {
      stop(sprintf("Unknown argument: %s", arg), call. = FALSE)
    }
    i <- i + 1
  }
  out
}

args <- parse_args(commandArgs(TRUE))
input_csv <- if (!is.null(args$input)) args$input else file.path(
  repo_root,
  "Data",
  "in-vivo",
  "CellCycelCells_pseudotime_distribution_per_sample_cell_level_with_ploidy_dose_tgi.csv"
)
fig_dir <- if (!is.null(args$output_dir)) file.path(args$output_dir, "figures") else file.path(repo_root, "Figs")
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)

df <- read.csv(input_csv, check.names = FALSE, stringsAsFactors = FALSE)

required_cols <- c(
  "sample_id",
  "gemcitabine_dose",
  "gemcitabine_dose_mg_per_kg",
  "cell_ploidy",
  "TGI_percent_Day_24"
)
missing_cols <- setdiff(required_cols, names(df))
if (length(missing_cols) > 0) {
  stop("Missing required column(s): ", paste(missing_cols, collapse = ", "))
}

treated_df <- df[df$gemcitabine_dose_mg_per_kg > 0, ]
if (nrow(treated_df) == 0) {
  stop("No treated cells found in input.")
}

treated <- do.call(
  rbind,
  lapply(sort(unique(treated_df$sample_id)), function(sample_id) {
    sample_df <- treated_df[treated_df$sample_id == sample_id, ]
    meta <- unique(sample_df[, c(
      "sample_id",
      "gemcitabine_dose",
      "gemcitabine_dose_mg_per_kg",
      "TGI_percent_Day_24"
    )])
    if (nrow(meta) != 1) {
      stop("Sample has inconsistent metadata: ", sample_id)
    }

    data.frame(
      sample_id = sample_id,
      dose = meta$gemcitabine_dose,
      dose_mg = meta$gemcitabine_dose_mg_per_kg,
      tgi_day24 = meta$TGI_percent_Day_24,
      ploidy_p90 = as.numeric(stats::quantile(
        sample_df$cell_ploidy,
        probs = 0.90,
        na.rm = TRUE,
        names = FALSE,
        type = 7
      )),
      stringsAsFactors = FALSE
    )
  })
)

treated$dose <- factor(
  treated$dose,
  levels = unique(treated$dose[order(treated$dose_mg)])
)

dose_cols <- c("30mg/kg" = "#fdae61", "120mg/kg" = "#7b3294")
dose_cols <- dose_cols[names(dose_cols) %in% levels(treated$dose)]

p <- ggplot(treated, aes(x = ploidy_p90, y = tgi_day24, color = dose)) +
  geom_point(size = 3) +
  geom_smooth(method = "lm", se = FALSE, linewidth = 0.8) +
  geom_text(
    aes(label = sample_id),
    size = 3,
    nudge_y = 2.5,
    check_overlap = TRUE,
    show.legend = FALSE
  ) +
  scale_color_manual(values = dose_cols, name = "dose") +
  labs(
    title = "Day 24 TGI versus 90th-percentile ploidy in treated samples",
    x = "90th pct cell ploidy",
    y = "TGI percent: Day 24"
  ) +
  theme_bw(base_size = 11) +
  theme(panel.grid.minor = element_blank())

png_path <- file.path(fig_dir, "ploidy_vs_TGI_Day24_p90_treated_by_dose.png")
pdf_path <- file.path(fig_dir, "ploidy_vs_TGI_Day24_p90_treated_by_dose.pdf")

suppressMessages(ggsave(png_path, p, width = 7, height = 5, dpi = 300))
suppressMessages(ggsave(pdf_path, p, width = 7, height = 5))
